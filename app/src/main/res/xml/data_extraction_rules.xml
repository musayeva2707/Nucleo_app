<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (Android 12+). The phone's own system does the backup; the app sends nothing. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
